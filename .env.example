SPRING_PROFILES_ACTIVE=dev

SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Base de datos
#   DEV (por defecto, H2 en memoria):
#     DB_URL=jdbc:h2:mem:orderdb;DB_CLOSE_DELAY=-1
#     DB_DRIVER=org.h2.Driver
#     DB_DIALECT=org.hibernate.dialect.H2Dialect
#     DB_DDL_AUTO=create-drop
#     DB_USERNAME=sa
#     DB_PASSWORD=
#
#   PROD (PostgreSQL) - OBLIGATORIAS (sin ellas la app no arranca):
#     DB_URL, DB_USERNAME, DB_PASSWORD
# ---------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/orderdb
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_DDL_AUTO=validate
DB_USERNAME=order_user
DB_PASSWORD=change_me

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2


REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

STRIPE_SECRET_KEY=your_stripe_secret_key_here
